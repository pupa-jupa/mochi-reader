{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal permissions for the Mochi Reader main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    "log:default",
    "clipboard-manager:allow-write-text",
    "window-state:default"
  ]
}
